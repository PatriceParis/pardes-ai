# Anthropic — required
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — required for embeddings
VOYAGE_API_KEY=pa-...

# LanceDB — local path used by scripts/index.py (NOT used by the app at runtime)
LANCEDB_PATH=./data/pardes.lance

# Upstash Vector — runtime retrieval (used by the Next.js app)
UPSTASH_VECTOR_REST_URL=https://...-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=...

# Models
ANTHROPIC_MAIN_MODEL=claude-sonnet-4-6
ANTHROPIC_GUARDRAIL_MODEL=claude-haiku-4-5-20251001
VOYAGE_EMBED_MODEL=voyage-3-large
VOYAGE_RERANK_MODEL=rerank-2.5

# Upstash Redis (conversation logs)
UPSTASH_REDIS_REST_URL=https://...-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Admin token to access /api/admin/conversations (protect your conversation logs)
ADMIN_TOKEN=set-a-random-secret-here

